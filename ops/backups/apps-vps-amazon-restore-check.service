[Unit]
Description=Restore and load-check the latest apps-vps Amazon backup
Documentation=file:/usr/local/bin/apps-vps-amazon-restore-check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/apps-vps-amazon-restore-check
ExecStopPost=/usr/local/libexec/restic-restore-export-metrics apps-vps-amazon-restore apps-vps
StandardOutput=append:/var/log/restic-restore-check.log
StandardError=append:/var/log/restic-restore-check.log
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
